generator client {
  provider      = "prisma-client-js"
  // native = local; rhel = Vercel/AWS Lambda Node runtimes
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

model Content {
  id            String    @id @default(cuid())
  url           String    @unique
  platform      Platform
  title         String?
  thumbnailUrl  String?   @map("thumbnail_url")
  /// Cached JPEG/PNG bytes so signed CDN URLs can expire without breaking UI
  thumbnailData Bytes?    @map("thumbnail_data")
  thumbnailMime String?   @map("thumbnail_mime")
  author        String?
  likes         Int       @default(0)
  comments      Int       @default(0)
  shares        Int       @default(0)
  views         Int       @default(0)
  postedAt      DateTime? @map("posted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  snapshots     Snapshot[]

  @@map("contents")
}

model Snapshot {
  id         String   @id @default(cuid())
  contentId  String   @map("content_id")
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  views      Int      @default(0)
  capturedAt DateTime @default(now()) @map("captured_at")

  @@index([contentId, capturedAt])
  @@map("snapshots")
}
