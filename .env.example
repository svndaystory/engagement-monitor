# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Update the values below, then copy to `.env` / `.env.local` for local development.

# Supabase Postgres connection string
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# ScrapeCreators API key (server-side only — never expose to the client)
SCRAPECREATORS_API_KEY=""

# Optional legacy/external scraper proxy URL (unused when SCRAPECREATORS_API_KEY is set)
SCRAPER_SERVICE_URL=""

# Shared secret for /api/cron/refresh-snapshots (Authorization: Bearer ...)
# Also set the same value as GitHub Actions secret CRON_SECRET.
# Set APP_URL GitHub secret to your production base URL (no trailing slash).
CRON_SECRET=""
